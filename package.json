{
    "name": "flux-workspace",
    "description": "Flux is a node-based automation platform.",
    "author": "Brad",
    "type": "module",
    "private": true,
    "packageManager": "pnpm@12.11.2",
    "scripts": {
        "tauri": "cd apps/desktop && pnpm tauri dev",
        "typecheck": "turbo run typecheck",
        "typecheck-app": "cd apps/desktop && pnpm typecheck",
        "typecheck-ui": "cd packages/ui && pnpm typecheck",
        "typecheck-api": "cd packages/api && pnpm typecheck",
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md,css,json}\"",
        "release": "node scripts/release.mjs"
    },
    "devDependencies": {
        "@clack/prompts": "^1.8.1",
        "picocolors": "^1.1.1",
        "prettier": "^3.9.10",
        "semver": "^7.8.5",
        "turbo": "latest"
    }
}
