{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Flux",
    "version": "2.1.0",
    "identifier": "com.fluxapp.flux",
    "build": {
        "beforeDevCommand": "pnpm run dev:vite",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm run build:vite",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "visible": false,
                "title": "",
                "width": 1050,
                "height": 750,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "transparent": true,
                "decorations": true,
                "dragDropEnabled": false,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "trafficLightPosition": {
                    "x": 16,
                    "y": 20
                }
            },
            {
                "label": "splashscreen",
                "url": "splashscreen.html",
                "width": 400,
                "height": 300,
                "center": true,
                "resizable": false,
                "maximizable": false,
                "minimizable": false,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "**"
                ]
            }
        }
    },
    "bundle": {
        "createUpdaterArtifacts": true,
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "externalBin": [
            "binaries/whatsapp-sidecar"
        ]
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5QzUzQkYwMkZCNjM3MTIKUldRU043WXY4RHZGYWZJdEtQeUp5YTd5bUk3SVRkTDd4VFYrVWtTRzNBSzJYTUhoeDFxNEpCQ2IK",
            "endpoints": [
                "https://github.com/BradMoyetones/flux/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
