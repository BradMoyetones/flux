{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "../shared/tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": ["."],
    "exclude": [
        "dist",
        "node_modules"
    ]
}
